#!/usr/bin/env bash
set -euo pipefail

# Resolve real script directory even if invoked through symlink
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SCRIPT_SOURCE" ]]; do
  SCRIPT_DIR_LINK="$(cd -P "$(dirname "$SCRIPT_SOURCE")" 2>/dev/null && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR_LINK/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" 2>/dev/null && pwd)"

# shellcheck source=/dev/null
source "$SCRIPT_DIR/syk4y-cli-lib/python_env.sh"

usage() {
  cat "$SCRIPT_DIR/templates/syk4y-update-usage.txt"
}

if [[ $# -gt 0 ]]; then
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
  esac
fi

python_bin="$(syk4y_resolve_python_bin_or_die "$SCRIPT_DIR" "syk4y update")"

exec "$python_bin" "$SCRIPT_DIR/syk4y-lib/update_cli.py" --install-dir "$SCRIPT_DIR" "$@"
