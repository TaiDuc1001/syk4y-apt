#!/usr/bin/env bash
set -euo pipefail

# Resolve real script directory even if invoked through symlink
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SCRIPT_SOURCE" ]]; do
  SCRIPT_DIR_LINK="$(cd -P "$(dirname "$SCRIPT_SOURCE")" 2>/dev/null && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR_LINK/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" 2>/dev/null && pwd)"

# shellcheck source=/dev/null
source "$SCRIPT_DIR/syk4y-cli-lib/project_root.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/syk4y-cli-lib/python_env.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/syk4y-cli-lib/kaggle_env.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/syk4y-cli-lib/string_utils.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/syk4y-cli-lib/kaggle_login.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/syk4y-cli-lib/kaggle_upload.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/syk4y-cli-lib/kaggle_zip.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/syk4y-cli-lib/kaggle_validate.sh"

usage() {
  cat "$SCRIPT_DIR/templates/kaggle-main-usage.txt"
}

main() {
  local explicit_root=""
  if [[ $# -gt 0 ]] && [[ "$1" == "--repo-root" ]]; then
    if [[ $# -lt 2 ]]; then
      echo "Missing value for --repo-root" >&2
      exit 2
    fi
    explicit_root="$2"
    shift 2
  fi

  local repo_root
  repo_root="$(syk4y_resolve_project_root "$explicit_root" "$(pwd)")"

  PYTHON_BIN="$(syk4y_resolve_python_bin_or_die "$repo_root" "syk4y")"

  if [[ $# -eq 0 ]]; then
    usage >&2
    exit 2
  fi

  local subcommand="$1"
  shift

  case "$subcommand" in
    login)
      kaggle_login "$@"
      ;;
    upload)
      kaggle_upload --repo-root "$repo_root" "$@"
      ;;
    zip)
      kaggle_zip --repo-root "$repo_root" "$@"
      ;;
    validate)
      kaggle_validate --repo-root "$repo_root" "$@"
      ;;
    account)
      exec "$PYTHON_BIN" "$SCRIPT_DIR/syk4y-lib/account_cli.py" "$@"
      ;;
    run)
      exec "$PYTHON_BIN" "$SCRIPT_DIR/syk4y-lib/run_cli.py" "$@"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      echo "Unknown kaggle subcommand: $subcommand" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
