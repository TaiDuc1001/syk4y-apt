#!/usr/bin/env bash
set -euo pipefail

# Resolve real script directory even if invoked through symlink
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SCRIPT_SOURCE" ]]; do
  SCRIPT_DIR_LINK="$(cd -P "$(dirname "$SCRIPT_SOURCE")" 2>/dev/null && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR_LINK/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" 2>/dev/null && pwd)"

# shellcheck source=/dev/null
source "$SCRIPT_DIR/syk4y-cli-lib/project_root.sh"

usage() {
  cat "$SCRIPT_DIR/templates/syk4y-main-usage.txt"
}

explicit_root=""
if [[ $# -gt 0 ]]; then
  case "$1" in
    --repo-root)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for --repo-root" >&2
        exit 2
      fi
      explicit_root="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
  esac
fi

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 2
fi

command="$1"
shift

repo_root="$(syk4y_resolve_project_root "$explicit_root" "$(pwd)")"

case "$command" in
  init)
    exec "$SCRIPT_DIR/syk4y-init" --repo-root "$repo_root" "$@"
    ;;
  gen)
    exec "$SCRIPT_DIR/syk4y-gen" --repo-root "$repo_root" "$@"
    ;;
  kaggle)
    exec "$SCRIPT_DIR/syk4y-kaggle" --repo-root "$repo_root" "$@"
    ;;
  doctor)
    exec "$SCRIPT_DIR/syk4y-doctor" --repo-root "$repo_root" "$@"
    ;;
  migrate-layout)
    exec "$SCRIPT_DIR/syk4y-migrate-layout" --repo-root "$repo_root" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
