#!/usr/bin/env bash
set -euo pipefail

# Resolve real script directory even if invoked through symlink
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SCRIPT_SOURCE" ]]; do
  SCRIPT_DIR_LINK="$(cd -P "$(dirname "$SCRIPT_SOURCE")" 2>/dev/null && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR_LINK/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" 2>/dev/null && pwd)"

# shellcheck source=/dev/null
source "$SCRIPT_DIR/syk4y-cli-lib/project_root.sh"

usage() {
  cat "$SCRIPT_DIR/templates/syk4y-init-usage.txt"
}

explicit_root=""
if [[ $# -gt 0 ]] && [[ "$1" == "--repo-root" ]]; then
  if [[ $# -lt 2 ]]; then
    echo "Missing value for --repo-root" >&2
    exit 2
  fi
  explicit_root="$2"
  shift 2
fi

repo_root_abs="$(syk4y_resolve_project_root "$explicit_root" "$(pwd)")"
args=(--repo-root "$repo_root_abs" --skip-gen)
artifacts=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -u|--upload-dir|-w|--wheelhouse)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for $1" >&2
        exit 2
      fi
      args+=("$1" "$2")
      shift 2
      ;;
    --arch)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for $1" >&2
        exit 2
      fi
      args+=(--arch "$2")
      shift 2
      ;;
    --wheel-arch)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for $1" >&2
        exit 2
      fi
      echo "Warning: --wheel-arch is deprecated and will be removed in a future version. Use --arch instead." >&2
      args+=(--arch "$2")
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      while [[ $# -gt 0 ]]; do
        artifacts+=("$1")
        shift
      done
      ;;
    -* )
      echo "Unknown init option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      artifacts+=("$1")
      shift
      ;;
  esac
done

if [[ "${#artifacts[@]}" -eq 0 ]]; then
  echo "Error: init requires at least one artifact." >&2
  usage >&2
  exit 2
fi

for artifact in "${artifacts[@]}"; do
  artifact_path=""
  if [[ -z "$artifact" ]]; then
    echo "Error: artifact name cannot be empty." >&2
    exit 2
  fi
  if [[ "$artifact" != "wheelhouse" ]]; then
    if [[ "$artifact" == /* ]]; then
      artifact_path="$artifact"
    else
      artifact_path="$repo_root_abs/$artifact"
    fi
    if [[ ! -e "$artifact_path" && ! -L "$artifact_path" ]]; then
      echo "Error: artifact '$artifact' does not exist (resolved: $artifact_path)." >&2
      exit 2
    fi
    if [[ ! -f "$artifact_path" && ! -d "$artifact_path" && ! -L "$artifact_path" ]]; then
      echo "Error: artifact '$artifact' must be a file, directory, or symlink (resolved: $artifact_path)." >&2
      exit 2
    fi
  fi
  args+=(--artifact "$artifact")
done

exec "$SCRIPT_DIR/syk4y-gen" "${args[@]}"
